#vim: set filetype=zsh

is_remote(){
  test -n "${SSH_CONNECTION}${SSH_CLIENT}"
}

is_root(){
  test $UID -eq 0
}

prompt_user(){
  local p_user='%F{blue}%n%f'
  is_root && p_user='%F{yellow}%B%n%b%f'

  echo "$p_user"
}

prompt_user_and_host(){
  if is_remote || is_root ; then
    local p_host='%F{green}%m%f'
    echo "$( prompt_user )@${p_host}:"
  else
    echo ''
  fi
}
